# The agent runs on Raspberry Pi OS Bookworm with Debian's own Python packages
# (no pip on the device). Tests run against exactly those versions.
FROM debian:bookworm-slim
RUN apt-get update  && apt-get install -y --no-install-recommends python3 python3-aiohttp python3-pil python3-pytest openssl ca-certificates  && rm -rf /var/lib/apt/lists/*
WORKDIR /src/agent
CMD ["python3", "-m", "pytest", "-q"]
