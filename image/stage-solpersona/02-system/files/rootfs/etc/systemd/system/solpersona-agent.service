[Unit]
Description=SolPersona Gallery agent (pairing, sync, the gallery on the card, screen power)
After=local-fs.target network.target solpersona-boot-config.service solpersona-firstboot.service
RequiresMountsFor=/var/lib/solpersona-gallery /var/cache/solpersona-gallery

[Service]
Type=notify
NotifyAccess=main
User=gallery
Group=gallery
ExecStart=/usr/lib/solpersona-gallery/run-agent
# Crash → restarted at once; a hung event loop stops petting the watchdog → killed and restarted.
Restart=always
RestartSec=1
WatchdogSec=30
TimeoutStopSec=10

RuntimeDirectory=solpersona-gallery
RuntimeDirectoryPreserve=yes
# Port 80 for the captive Wi-Fi setup page, on the setup network's address only.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/solpersona-gallery /var/cache/solpersona-gallery /run/solpersona-gallery -/run/user
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
