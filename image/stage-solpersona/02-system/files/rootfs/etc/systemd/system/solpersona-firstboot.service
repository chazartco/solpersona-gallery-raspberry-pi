[Unit]
Description=SolPersona Gallery: prepare the card (first start only)
# Once: the marker is written to the root before it becomes read-only.
ConditionPathExists=!/etc/solpersona-gallery/firstboot-done
# Raspberry Pi Imager's settings are applied by its own script in a boot of
# their own, which deletes the script when done: wait for that boot to finish.
ConditionPathExists=!/boot/firmware/firstrun.sh
# Ordinary dependencies (after sysinit), before everything that uses the data
# partition. Ordering this before sysinit.target made a cycle with units that
# run after it, and systemd dropped this job.
After=local-fs.target systemd-remount-fs.service boot-firmware.mount
Before=NetworkManager.service solpersona-agent.service solpersona-kiosk.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/lib/solpersona-gallery/firstboot.sh
StandardOutput=journal+console
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
