[Unit]
Description=SolPersona Gallery: apply the settings file (time zone, Wi-Fi country)
DefaultDependencies=no
After=local-fs.target boot-firmware.mount
Before=NetworkManager.service solpersona-agent.service solpersona-kiosk.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/solpersona-gallery/boot-config.sh

[Install]
WantedBy=sysinit.target
